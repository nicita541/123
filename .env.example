# Host folder whose direct or nested subfolders can be registered as projects.
AGENT_PROJECTS_ROOT=./examples

# Absolute path as seen by the backend container. It must be below /projects.
AGENT_DEFAULT_PROJECT=/projects/docker_workspace

# Ollama runs in Compose; only the model is configurable from the host.
OLLAMA_MODEL=qwen2.5-coder:1.5b
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_MODEL=qwen2.5-coder:7b-instruct
# OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_IMAGE=ollama/ollama:latest

# On Linux, match bind-mounted project ownership. Docker Desktop can keep the defaults.
AGENT_UID=1000
AGENT_GID=1000
